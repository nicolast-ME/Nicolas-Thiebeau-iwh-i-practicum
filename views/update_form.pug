doctype html
html
  head
    title= title
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #2c2f36; 
        margin: 0;
        padding: 0;
      }
      h1 {
        text-align: center;
        margin: 24px 0 12px;
        font-size: 26px;
        color: #fff; 
      }
      .form-container {
        max-width: 760px;
        margin: 0 auto 40px;
        padding: 24px;
        background-color: #ffffff; 
        border-radius: 10px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
        color: #111; 
      }
      .field {
        margin: 12px 0 18px;
      }
      .label {
        display: block;
        width: 75%;
        margin: 0 auto 6px;
        font-size: 14px;
        font-weight: 600;
        color: #111; 
      }
      .input {
        display: block;
        width: 75%;           
        margin: 0 auto;
        padding: 10px 12px;
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        font-size: 14px;
        background: #fff;
        color: #111;
      }
      .input:focus {
        outline: none;
        border-color: #4e9dff;
        box-shadow: 0 0 0 3px rgba(78,157,255,0.2);
      }
      ::placeholder { color: #9aa3ad; }
      .btn {
        display: block;
        width: 25%;
        margin: 12px auto 0;
        padding: 12px;
        border: none;
        border-radius: 6px;
        background-color: #4e9dff; 
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
      }
      .btn:hover { background-color: #3f8be0; }
      a.home {
        display: block;
        text-align: center;
        margin-top: 14px;
        color: #4e9dff;
        text-decoration: none;
        font-weight: 600;
      }
      a.home:hover { text-decoration: underline; }
  body
    h1 Add New IT Asset
    .form-container
      form(action="/update-cobj" method="POST")
        .field
          label.label(for="name") Name
          input.input(type="text" name="name" id="name" required placeholder="e.g., Laptop")
        .field
          label.label(for="make") Make
          input.input(type="text" name="make" id="make" required placeholder="e.g., Apple")
        .field
          label.label(for="model") Model
          input.input(type="text" name="model" id="model" required placeholder="e.g., MacBook Pro")
        .field
          label.label(for="serial_number") Serial Number
          input.input(type="text" name="serial_number" id="serial_number" required placeholder="e.g., C02CK2NGM")
        .field
          label.label(for="purchase_date") Purchase Date
          input.input(type="date" name="purchase_date" id="purchase_date" required)
        .field
          label.label(for="warranty_end_date") Warranty End Date
          input.input(type="date" name="warranty_end_date" id="warranty_end_date" required)
        .field
          label.label(for="description") Description
          input.input(type="text" name="description" id="description" placeholder="Optional note or configuration")

        button.btn(type="submit") Submit
      a.home(href="/") Return to Homepage
